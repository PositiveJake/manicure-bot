{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manicure-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manicure-bookings",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
